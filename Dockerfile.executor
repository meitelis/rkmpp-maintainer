# Disposable source-script runner in the isolated inner Docker daemon.
# Candidate repository shell scripts must never run alongside the maintainer's
# GitHub token or other controller environment variables.
FROM docker:29.9.3-cli@sha256:2357639ad1ea7d0194134bf3292622fd4e562483966ed674e5d7c945b5f3b28d
RUN apk add --no-cache bash ca-certificates coreutils findutils git python3
ENV HOME=/tmp
