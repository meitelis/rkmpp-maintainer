# Nightly candidate preparation only; no production application deployment.
# Set false for a true idle controller (no pointless release polling).
AUTO_UPDATE=true
# Create a PR only after the local model, source checks, build and hardware
# matrix succeed. Needs a GitHub fine-grained token scoped to both forks.
AUTO_PUBLISH=false
GITHUB_TOKEN=
# Portainer: watch prepares candidates nightly, idle is for manual Console jobs.
MAINTAINER_ACTION=watch
# Set only if nested overlay2 is unsupported on this host. vfs needs more disk.
DIND_STORAGE_DRIVER=overlay2
# Optional compatible local inference endpoint, e.g. an RKLLM server adapter.
# External servers manage their own model loading/unloading.
MODEL_ENDPOINT=
